# AfriPuente — environment template. PLACEHOLDERS ONLY.
# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon Postgres) ---------------------------------------------
# Keep `connection_limit` and `pool_timeout`. Prisma defaults to a small pool,
# and dev hot-reloads plus per-request session lookups exhaust it quickly —
# the symptom is P2024 "Timed out fetching a new connection from the pool".
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require&connection_limit=10&pool_timeout=20"

# --- Pollar ----------------------------------------------------------------
# Publishable key. Safe in the browser; it is origin-locked in the Pollar
# dashboard under Build -> Domains. Ramp endpoints REQUIRE this key type —
# a secret key is rejected with API_KEY_TYPE_NOT_ALLOWED.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY="pub_testnet_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Secret key. SERVER ONLY. Never expose to the browser.
POLLAR_SECRET_KEY="sec_testnet_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Personal access token for dashboard/management calls. SERVER ONLY.
POLLAR_PAT="pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

POLLAR_APP_ID="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POLLAR_BASE_URL="https://sdk.api.pollar.xyz"

# --- Stellar ---------------------------------------------------------------
# 'testnet' or 'mainnet'. Testnet evidence is NOT redeemable for real money.
# These two MUST agree. Horizon is how the app independently verifies that a
# settlement really happened, so pointing a mainnet app at testnet Horizon does
# not weaken verification - it invalidates it. The app refuses to start on a
# mismatch.
#
#   testnet -> https://horizon-testnet.stellar.org
#   mainnet -> https://horizon.stellar.org
#
# Keep this on testnet unless you intend real money to move.
NEXT_PUBLIC_STELLAR_NETWORK="testnet"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# --- Session ---------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_generate_a_32_byte_base64_secret"

# --- Corridor configuration ------------------------------------------------
# Execution mode for the Nigerian funding leg.
#
#   SIMULATED  (default, safest) The funding screen shows NO account at all:
#              "NO ACCOUNT - SANDBOX MODE". Nothing can be mistaken for a real
#              collection account.
#   SANDBOX    Shows labelled TEST bank details so a demo shows the complete
#              screen. Uses NGN_PARTNER_* below when set, otherwise a built-in
#              test account (0000000000, not a valid NUBAN). No money moves.
#   LIVE       A real partner account that really receives money. The app
#              REFUSES TO START in this mode unless all three NGN_PARTNER_*
#              values are set, so it can never show a blank "real" account.
#
# Use SANDBOX for a demo or hackathon submission. Use LIVE only with a real,
# agreed funding partner.
NGN_FUNDING_MODE="SIMULATED"

# Funding partner details.
#   SIMULATED - ignored, leave blank
#   SANDBOX   - optional test values; a built-in test account is used if blank
#   LIVE      - REQUIRED, all three
NGN_PARTNER_NAME=""
NGN_PARTNER_BANK=""
NGN_PARTNER_ACCOUNT=""

# Indicative NGN -> USD rate for the funding leg, as an exact decimal string.
# This leg has NO provider quote, so this rate is operator-set and the UI
# labels it "indicative", never "guaranteed".
NGN_PER_USD_INDICATIVE="1650.00"

# AfriPuente's NGN-side charge, in basis points.
NGN_FUNDING_FEE_BPS="150"

# Indicative BOB per 1 USDC, used ONLY to show an estimate before a real Pollar
# ramp quote exists. A provider quote always overrides it, and any quote built
# from this value is labelled "estimate only", never "guaranteed".
# Observed from Pollar's Bolivian provider on mainnet (2026-09-18): ~10.87 BOB
# per dollar. Bolivia's OFFICIAL peg is 6.96, but that is not the rate the
# provider actually pays out at, and an estimate should reflect what the
# recipient really receives. A live provider quote always overrides this.
BOB_PER_USD_INDICATIVE="10.87"

# --- Operator access -------------------------------------------------------
# Legacy display configuration; emails no longer grant operator access.
# Operator authority is ALWAYS re-checked server-side against the database.
OPERATOR_EMAILS=""

# Operator permission is bound to a wallet proven with SEP-53, not an email
# supplied by the browser. Comma-separated network:public-address entries.
# Example format: mainnet:G... (use the full 56-character public address).
OPERATOR_WALLETS=""
