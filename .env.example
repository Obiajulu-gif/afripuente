# AfriPuente — environment template. PLACEHOLDERS ONLY.
# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon Postgres) ---------------------------------------------
# Keep `connection_limit` and `pool_timeout`. Prisma defaults to a small pool,
# and dev hot-reloads plus per-request session lookups exhaust it quickly —
# the symptom is P2024 "Timed out fetching a new connection from the pool".
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require&connection_limit=10&pool_timeout=20"

# --- Pollar ----------------------------------------------------------------
# Publishable key. Safe in the browser; it is origin-locked in the Pollar
# dashboard under Build -> Domains. Ramp endpoints REQUIRE this key type —
# a secret key is rejected with API_KEY_TYPE_NOT_ALLOWED.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY="pub_testnet_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Secret key. SERVER ONLY. Never expose to the browser.
POLLAR_SECRET_KEY="sec_testnet_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Personal access token for dashboard/management calls. SERVER ONLY.
POLLAR_PAT="pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

POLLAR_APP_ID="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POLLAR_BASE_URL="https://sdk.api.pollar.xyz"

# --- Stellar ---------------------------------------------------------------
# 'testnet' or 'mainnet'. Testnet evidence is NOT redeemable for real money.
NEXT_PUBLIC_STELLAR_NETWORK="testnet"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# --- Session ---------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_generate_a_32_byte_base64_secret"

# --- Corridor configuration ------------------------------------------------
# Execution mode for the Nigerian funding leg: SIMULATED | SANDBOX | LIVE
# SIMULATED shows sandbox instructions that cannot be mistaken for a real
# collection account. Only set LIVE with a real, agreed partner account.
NGN_FUNDING_MODE="SIMULATED"

# Pilot funding partner details. Leave blank in SIMULATED mode.
NGN_PARTNER_NAME=""
NGN_PARTNER_BANK=""
NGN_PARTNER_ACCOUNT=""

# Indicative NGN -> USD rate for the funding leg, as an exact decimal string.
# This leg has NO provider quote, so this rate is operator-set and the UI
# labels it "indicative", never "guaranteed".
NGN_PER_USD_INDICATIVE="1650.00"

# AfriPuente's NGN-side charge, in basis points.
NGN_FUNDING_FEE_BPS="150"

# Indicative BOB per 1 USDC, used ONLY to show an estimate before a real Pollar
# ramp quote exists. A provider quote always overrides it, and any quote built
# from this value is labelled "estimate only", never "guaranteed".
BOB_PER_USD_INDICATIVE="6.96"

# --- Operator access -------------------------------------------------------
# Comma-separated emails granted the OPERATOR role on first sign-in.
# Operator authority is ALWAYS re-checked server-side against the database.
OPERATOR_EMAILS=""
